# Kopjoje këtë skedar si ".env" dhe përshtate vlerat.
PORT=4000
JWT_SECRET=ndrysho-kete-sekret-ne-produksion
DEMO_STARTING_CREDITS=500

# ── Lidhja me MySQL / MariaDB ──────────────────────────────────────────────
# Këto parazgjedhje punojnë me një instalim standard XAMPP/MySQL lokal.
# Baza "parking_system" krijohet automatikisht nëse nuk ekziston.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=adminadmin123          # empty for a default XAMPP install; set yours here
MYSQL_DATABASE=parking_system
# Optional, only if your MySQL connects via a socket instead of TCP:
# MYSQL_SOCKET=/var/run/mysqld/mysqld.sock

# Placeholder të integrimeve të pagesave (mos i vendos kredencialet në kod)
SMS_GATEWAY_API_KEY=PLACEHOLDER
TERMINAL_PROVIDER_API_KEY=PLACEHOLDER
CARD_PROVIDER_API_KEY=PLACEHOLDER
